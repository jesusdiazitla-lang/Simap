# Normalizar finales de línea. Los scripts de shell y hooks DEBEN ser LF
# (con CRLF el intérprete /bin/sh falla en Linux/macOS y en CI).
* text=auto
*.sh        text eol=lf
.githooks/* text eol=lf
*.ps1       text eol=crlf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.cjs       text eol=lf
*.mjs       text eol=lf
*.css       text eol=lf
# Binarios
*.png binary
*.ico binary
*.svg text eol=lf
