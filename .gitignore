# ---------------------------------------------------------------------------
# SIMAP - archivos ignorados por git
# ---------------------------------------------------------------------------

# --- Instrucciones para agentes de IA (NO versionadas, por decisión del equipo)
CLAUDE.md
AGENT.md
AGENTS.md
.claude/settings.local.json

# --- Python / backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# --- Node / frontend
node_modules/
.next/
out/
.turbo/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
.eslintcache

# --- Variables de entorno (nunca versionar secretos)
.env
.env.*
!.env.example

# --- Base de datos local
*.sqlite
*.sqlite3
*.db

# --- Artefactos del grafo de dependencias
# El snapshot generado se regenera con `python tools/graph/graph.py build`.
.graph/*
!.graph/.gitkeep

# --- Editores y SO
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Skills y configuracion de harnesses de IA (impeccable, ui-ux-pro-max, ...)
# Instaladas por herramienta (`npx impeccable install`), no forman parte del codigo
# del proyecto. Misma decision que CLAUDE.md / AGENT.md: cada quien instala las suyas.
.agents/
.augment/
.claude/
.codebuddy/
.codewhale/
.codex/
.continue/
.cursor/
.factory/
.gemini/
.kilocode/
.kiro/
.opencode/
.qoder/
.roo/
.trae/
.warp/
.windsurf/
# En .github solo se ignoran las subcarpetas de agentes: workflows/ SI se versiona.
.github/agents/
.github/hooks/
.github/prompts/
.github/skills/

# --- Salida del grafo de conocimiento de graphify (regenerable con `/graphify .`)
graphify-out/

# Impeccable: se versionan el contrato de direccion de cada superficie y el sidecar del sistema de
# diseno, que son decisiones de diseno del proyecto y los lee el detector. El resto (cache del hook,
# registros de las paginas de decision, capturas de revision, preferencias locales de cada maquina)
# es estado de la herramienta y se regenera.
.impeccable/*
!.impeccable/surfaces/
!.impeccable/design.json
