# Copiar a .env y ajustar. Nunca versionar .env.
APP_NAME=SIMAP API
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# El usuario DEBE ser app_user. Hay tres roles y solo este vale para el backend:
#   simap        superusuario -> ignora RLS SIEMPRE. Solo para administrar.
#   simap_owner  dueno de las tablas -> para migraciones de Alembic.
#   app_user     ni superusuario ni dueno -> el unico correcto aqui.
# Conectar con cualquiera de los otros dos desactiva el aislamiento entre
# empresas sin un solo error. Ver backend/db/rls_policies.sql, secciones 1 y 5.
DATABASE_URL=postgresql+asyncpg://app_user:changeme@localhost:5432/simap
# URL para migraciones (Alembic). No la usa la aplicacion en ejecucion.
DATABASE_URL_MIGRACIONES=postgresql+asyncpg://simap_owner:changeme_owner@localhost:5432/simap
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0

# Obligatorio, de al menos 32 caracteres, y distinto por ambiente (dev/test/produccion).
# Sin el, o con este valor de ejemplo, la API no arranca. Generar uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-propio
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Argon2id. memory_cost en KiB (65536 KiB = 64 MiB por hash).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Rate limiting de /auth/login
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=60

# Cookies de sesion. En LOCAL tiene que ir a false: sin HTTPS el navegador descarta
# una cookie `secure` y el login no funciona, sin ningun error visible que lo explique.
# En cualquier otro entorno se deja en true; es lo que impide que la sesion viaje en claro.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Registro de campo (F2) -------------------------------------------------
# Direccion publica del frontend: el QR de cada equipo codifica APP_BASE_URL/a/{codigo}.
APP_BASE_URL=http://localhost:3000
# Horometro: tope admitido y holgura (horas) al comprobar que no suba mas que el reloj.
HOROMETRO_MAX=1000000
HOROMETRO_TOLERANCIA_HORAS=2
# Ventana admitida de capturado_en: minutos en el futuro y dias hacia atras.
CAPTURA_TOLERANCIA_FUTURO_MINUTOS=5
CAPTURA_ANTIGUEDAD_MAX_DIAS=14
# Misma persona, mismo equipo y mismo sintoma dentro de esta ventana = una sola alerta.
ALERTA_DEDUP_MINUTOS=10
# Limites por usuario y minuto. La resolucion de codigos lleva el suyo, mas estricto.
CAMPO_MAX_PETICIONES_POR_MINUTO=60
CODIGO_MAX_PETICIONES_POR_MINUTO=30
PAGINA_MAX=100

# Ordenes de trabajo (F3): reportes de falla y transiciones por usuario y minuto. Un bucle en el
# cliente no debe poder llenar el historial, que no se puede borrar.
FALLA_MAX_POR_MINUTO=20
TRANSICION_MAX_POR_MINUTO=60

# Detras de un proxy (los rewrites de Next o el del hosting), uvicorn solo cree a X-Forwarded-For
# si la peticion viene de una IP de esta lista. Por defecto 127.0.0.1, que vale en local. En
# produccion poner la del proxy real: si no, el limite de login por IP ve una sola IP para todos.
# Nunca "*": cualquiera podria inventarse la cabecera. (Lo lee uvicorn, no la aplicacion.)
# FORWARDED_ALLOW_IPS=127.0.0.1

# Tope de intentos de login por IP y minuto. Mayor que el de por correo (LOGIN_MAX_ATTEMPTS) porque
# una planta sale a internet por una sola IP; un acierto no lo reinicia.
LOGIN_MAX_INTENTOS_POR_IP=30

# Fase 4. El umbral de riesgo, el horizonte y el multiplicador son de cada empresa
# (configuracion_empresa, decision 5) y los ajusta su administrador.
# Job nocturno: rol propio, sujeto a RLS (backend/db/roles.sql).
DATABASE_URL_JOB=postgresql+asyncpg://job_user:changeme_job@localhost:5432/simap
# true: APScheduler lo corre dentro del backend a las 02:00 de Santo Domingo. En produccion lo
# sustituye un cron que ejecuta `python -m app.jobs.diario`.
JOB_DIARIO_EN_PROCESO=true
JOB_DIARIO_HORA=2
JOB_ZONA_HORARIA=America/Santo_Domingo
# Inventario: cambios de lineas e ingresos por usuario y minuto.
LINEA_REPUESTO_MAX_POR_MINUTO=30
INGRESO_MAX_POR_MINUTO=20

# Fase 5. /docs, /redoc y /openapi.json. En produccion: false (no anunciar la superficie de la API).
EXPONER_DOCS=true
